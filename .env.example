# Local API. Railway: add the PostgreSQL plugin and set this from its connection string.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bill-tracker;Username=postgres;Password=postgres

# Browser origins allowed to call the API. On Railway, set the Vercel origin.
Cors__Origins__0=http://localhost:5173

# Web, baked in at Vercel build time. Point it at the Railway API URL.
VITE_API_URL=http://localhost:5080

# docker compose db service
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bill-tracker

# API listen port. Railway sets this; local Docker uses 8080.
PORT=8080

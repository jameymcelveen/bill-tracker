{
  "name": "billtracker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "gen:api:check": "mkdir -p node_modules/.cache && openapi-typescript ../contracts/openapi.yaml -o node_modules/.cache/schema-check.d.ts && cmp node_modules/.cache/schema-check.d.ts src/api/generated/schema.d.ts && echo 'Generated API types match the contract'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
